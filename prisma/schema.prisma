// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// Heroku drawback: In order to avoid permission issues we need shadowDatabasUrl
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------- Users ----------
model User {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  email        String   @unique
  passwordHash String

  playlists Playlist[]

  firstName String
  lastName String
  // If Postgres and you want case-insensitive email uniqueness:
  // email String @unique @db.Citext

  @@index([email])
}

// ---------- Artists ----------
model Artist {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  // M:N links
  songLinks  SongArtist[]
  albumLinks AlbumArtist[]

  @@index([name])
}

// ---------- Albums ----------
model Album {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String
  releaseDate DateTime?
  coverUrl    String?

  songs   Song[]
  artists AlbumArtist[] // M:N with metadata (role/order)
  // Optional de-dup constraint (tune to your needs):
  // @@unique([title, releaseDate])

  @@index([releaseDate])
}

// ---------- Songs ----------
model Song {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  durationMs  Int?
  trackNumber Int?
  discNumber  Int?
  url         String // NEW: required URL for the audio source

  // Album is optional; set albumId to Int (required) + onDelete: Cascade if you want to enforce membership.
  album   Album? @relation(fields: [albumId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  albumId Int?

  // M:N links
  artists       SongArtist[]
  playlistItems PlaylistSong[]

  @@index([albumId])
  @@index([name])
}

// ---------- Playlists ----------
model Playlist {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String?
  isPublic    Boolean  @default(false)

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  items PlaylistSong[] // M:N to songs (with addedAt/position)

  // Helpful to avoid duplicate names per user (optional):
  @@unique([userId, name])
  @@index([userId])
  @@index([isPublic])
}

// ---------- Join models with metadata ----------
model PlaylistSong {
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  playlistId Int
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  songId     Int

  addedAt  DateTime @default(now())
  position Int? // custom ordering inside a playlist

  @@id([playlistId, songId]) // one song per playlist once
  @@index([songId])
}

model SongArtist {
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  songId   Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  artistId Int

  role  String? // "primary", "featured", "producer", ...
  order Int? // display order

  @@id([songId, artistId])
  @@index([artistId])
}

model AlbumArtist {
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  albumId  Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  artistId Int

  role  String? // e.g., "primary", "featured"
  order Int?

  @@id([albumId, artistId])
  @@index([artistId])
}
